# docker/Dockerfile.prod

# ============================================================
# Stage 1: Builder — cài đặt dependencies
# ============================================================
FROM python:3.12-slim AS builde

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Cài đặt build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Cài đặt Python dependencies vào thư mục riêng
COPY requirements/base.txt requirements/prod.txt ./requirements/
RUN pip install --no-cache-dir --prefix=/install -r requirements/prod.txt

# ============================================================
# Stage 2: Runtime — image production tối giản
# ============================================================
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings.prod

WORKDIR /app

# Chỉ cài đặt runtime dependencies (không có gcc, build tools)
RUN apt-get update && apt-get install -y \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copy Python packages từ builder stage
COPY --from=builder /install /usr/local

# Tạo user không có quyền root để chạy ứng dụng
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser

# Copy source code
COPY --chown=appuser:appgroup . .

# Tạo thư mục staticfiles và media
RUN mkdir -p /app/staticfiles /app/media \
    && chown -R appuser:appgroup /app/staticfiles /app/media

# Copy và cấp quyền entrypoint script
COPY --chown=appuser:appgroup docker/scripts/entrypoint.prod.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER appuser

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
