# Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database
POSTGRES_DB=taskmanager_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email (Gmail SMTP)
# Hướng dẫn lấy App Password: https://myaccount.google.com/apppasswords
# Bật 2-Step Verification trước, sau đó tạo App Password cho "Mail"
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Task Manager <your-gmail@gmail.com>

# Frontend URL dùng để tạo link xác thực trong email
FRONTEND_URL=http://localhost:8000
