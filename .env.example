# ============================================================
# Task Management System — Biến Môi Trường
# Sao chép file này thành .env và điền giá trị thực tế
# KHÔNG commit file .env vào version control
# ============================================================

# Django Core
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskmanager_dev
POSTGRES_DB=taskmanager_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email (Gmail SMTP)
# Hướng dẫn lấy App Password: https://myaccount.google.com/apppasswords
# Bật 2-Step Verification trước, sau đó tạo App Password cho "Mail"
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Task Manager <your-gmail@gmail.com>

# Frontend URL dùng để tạo link xác thực trong email
FRONTEND_URL=http://localhost:8000

# ============================================================
# Redis & Cache
# ============================================================

# URL kết nối Redis (dùng cho Django cache backend)
REDIS_URL=redis://localhost:6379/0

# Thời gian sống mặc định của cache entry (giây, mặc định 300 = 5 phút)
CACHE_TTL=300

# ============================================================
# Celery (Background Tasks & Cache Invalidation)
# ============================================================

# URL broker cho Celery (dùng Redis database 1)
CELERY_BROKER_URL=redis://localhost:6379/1

# URL lưu kết quả task của Celery (dùng Redis database 2)
CELERY_RESULT_BACKEND=redis://localhost:6379/2
